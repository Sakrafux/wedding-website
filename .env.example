# Example environment for the wedding app. Copy to .env and fill in.
# Configuration is environment variables only — there is no config file. Every
# required variable missing means the container exits at startup instead of coming
# up in a half-configured state.

# --- Required -----------------------------------------------------------------

# SQLite database file. Must live on a mounted volume: it holds the RSVPs and the
# household login codes in plaintext, so treat this file itself as a secret.
DB_PATH=/data/wedding.db

# Photo storage root, also on a mounted volume. Originals are kept byte-for-byte.
PHOTO_DIR=/data/photos

# The single admin account. There is no admin table and no password reset — these
# two variables are the credentials.
ADMIN_USER=admin

# Plaintext, minimum 12 characters. Readable by anyone with server access; accepted.
ADMIN_PASSWORD=change-me-please-really

# --- Optional -----------------------------------------------------------------

# Listen port inside the container. The reverse proxy in front of it terminates TLS.
PORT=8080

# One of debug, info, warn, error.
LOG_LEVEL=info

# Set to false ONLY for local development over plain HTTP; a Secure cookie is not
# sent over http://localhost, so login would silently fail.
SESSION_COOKIE_SECURE=true

# Comma-separated CIDRs whose X-Forwarded-For header is believed when resolving the
# client IP for rate limiting. Empty = trust nobody, use the direct peer address.
# A malformed entry fails startup on purpose: a silently ignored proxy network makes
# the login rate limit bypassable.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
