/wedding
# Build output. The directory itself is tracked via its .gitkeep: the Go binary
# embeds web/dist, and an embed of a directory that does not exist fails the build
# on a clean checkout before the frontend has ever been built.
web/dist/*
!web/dist/.gitkeep
web/node_modules/
*.db
*.db-wal
*.db-shm

# Local environment. Holds ADMIN_PASSWORD in plaintext; .env.example is the
# committed counterpart.
.env
.env.local

# Local runtime state: dev database and photo directory from .env.
/local/
